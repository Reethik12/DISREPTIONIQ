# ==============================================================================
# DISRUPTIONIQ — Environment Configuration Template
# Placeholders only. Never commit real secrets or production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'development', 'test', or 'production'.
NODE_ENV=development

# Server binding host (127.0.0.1 for local development, 0.0.0.0 for containers)
HOST=127.0.0.1

# HTTP port (e.g. 3000, 4010)
PORT=4010

# Automatic port fallback when port is busy (true / false)
PORT_FALLBACK=true

# Maximum number of port increment attempts
PORT_SCAN_LIMIT=30

# ------------------------------------------------------------------------------
# 2. VERCEL & DEMONSTRATION MODE
# ------------------------------------------------------------------------------
# When deploying to Vercel for preview or evaluation, set DEMO_MODE=true
# to allow the 4 built-in role demonstration accounts to be active.
# In strict production with dedicated operational users, leave this false.
DEMO_MODE=false

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite database path.
# Defaults to ./instance/disruptioniq.db locally, or /tmp/disruptioniq.db on Vercel serverless.
DATABASE_PATH=

# Hosted PostgreSQL connection string (for production migration path on Vercel)
# e.g. postgresql://user:password@ep-sample-123456.us-east-1.aws.neon.tech/disruptioniq?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# 4. SECURITY & INTEGRATIONS
# ------------------------------------------------------------------------------
# Mandatory in production for carrier webhook verification (/api/webhooks/carrier)
WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. DEMO ACCOUNT PASSWORDS (Development / Preview Overrides)
# ------------------------------------------------------------------------------
# If left blank, default demo passwords from START_HERE.txt are used:
# Hub In-Charge:     Hub@DIQ2026!
# Risk Analyst:      Risk@DIQ2026!
# Recovery Manager:  Recover@DIQ2026!
# Customer:          Customer@DIQ2026!
DEMO_HUB_PASSWORD=
DEMO_RISK_PASSWORD=
DEMO_RECOVERY_PASSWORD=
DEMO_CUSTOMER_PASSWORD=

# ------------------------------------------------------------------------------
# 6. PRODUCTION USER CREATION (scripts/create-hub-user.js)
# ------------------------------------------------------------------------------
CREATE_HUB_USERNAME=
CREATE_HUB_EMAIL=
CREATE_HUB_NAME=
CREATE_HUB_PASSWORD=

# ------------------------------------------------------------------------------
# 7. OPTIONAL ADVISORY AI EXPLANATION ENGINE
# ------------------------------------------------------------------------------
# Supported providers: 'none', 'openai-compatible', 'gemini'
LLM_PROVIDER=none
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=8
LLM_CACHE_TTL=300
